{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Atlas Engine Manifest",
  "type": "object",
  "required": ["engine_id", "name", "supported_os", "trust_level", "requires_admin", "capabilities"],
  "properties": {
    "engine_id": { "type": "string", "minLength": 3 },
    "name": { "type": "string" },
    "supported_os": { "type": "string", "enum": ["windows", "macos", "linux"] },
    "trust_level": { "type": "string", "enum": ["system", "vendor", "community"] },
    "requires_admin": { "type": "boolean" },
    "allowed_by_default": { "type": "boolean", "default": false },
    "capabilities": {
      "type": "array",
      "items": { "type": "string", "enum": ["inventory", "check_updates", "download", "install", "rollback", "verify"] }
    },
    "notes": { "type": "string" }
  }
}
